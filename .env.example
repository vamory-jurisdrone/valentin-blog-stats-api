# Copier en .env puis adapter : cp .env.example .env
# Chaque variable a une valeur par défaut dans compose.yaml : ce fichier est facultatif en local.

# --- Base MariaDB (conteneur stats-db) ---
DB_USER=stats
DB_PASSWORD=stats
DB_ROOT_PASSWORD=root
# Port publié sur l'hôte, sur 127.0.0.1 uniquement (3306 dans le réseau Docker).
# 3307 par défaut : 3306 est souvent occupé par le MariaDB/MySQL local (XAMPP) du blog Symfony.
DB_PORT=3307

# --- API (conteneur stats-api) ---
API_PORT=8080
# Application cliente (backend Symfony) : échange ces identifiants contre un JWT sur POST /api/auth/token
# (grant client_credentials, HTTP Basic). Mêmes valeurs côté Symfony. À changer en production.
STATS_CLIENT_ID=symfony-blog
# Secret du client : openssl rand -hex 32 (hexadécimal : rien à encoder dans l'en-tête Basic)
STATS_CLIENT_SECRET=change-me
# Clé HMAC de signature des JWT (HS256), connue de l'API seule, au moins 32 octets : openssl rand -base64 48
STATS_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Durée de vie d'un jeton, en minutes (expires_in = 900 s par défaut)
STATS_TOKEN_TTL_MINUTES=15
# Origines autorisées à envoyer les événements depuis le navigateur (séparées par des virgules)
STATS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://127.0.0.1:8000
# Événements acceptés par minute et par IP sur /api/events/** (0 = pas de limite)
STATS_RATELIMIT_EVENTSPERMINUTE=60
# Demandes de jeton acceptées par minute et par IP sur /api/auth/token (0 = pas de limite)
STATS_RATELIMIT_TOKENREQUESTSPERMINUTE=10
# Regex (Java) des IP de reverse proxy dont on croit l'en-tête X-Forwarded-For. Défaut : boucle locale.
# En production derrière nginx/Caddy : l'IP sous laquelle le proxy joint le conteneur, par exemple la
# passerelle du réseau Docker (docker network inspect blog-stats_default → Gateway) : 172\.18\.0\.1
# Mal réglée, tous les clients partagent le quota du proxy (429 en masse) ; trop large, un client
# peut changer d'IP apparente et contourner la limite.
STATS_TRUSTED_PROXIES='127\.\d+\.\d+\.\d+|0:0:0:0:0:0:0:1|::1'
# Vide = production ; "demo" = charge des articles et événements de démonstration au démarrage
SPRING_PROFILES_ACTIVE=
